# these lines also catch a binary copied in by hand.
*.dylib
*.so
*.a
*.framework/
*.xcframework/
*.xcarchive/
*.dSYM/
*.apk
*.aab
*.ipa
*.zip
consumer/build/
consumer/.dart_tool/
